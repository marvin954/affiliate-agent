# --- Hermes CLI (preferred) ---
# Path to the Hermes binary. The app auto-detects common layouts:
#   /home/mammba/.hermes          (if it's the binary itself)
#   /home/mammba/.hermes/hermes   (binary inside the directory)
#   hermes                        (if it's on your PATH)
# Override with the exact command if auto-detect doesn't work:
# HERMES_CMD=/home/mammba/.hermes/hermes
HERMES_PATH=/home/mammba/.hermes

# --- Hermes HTTP fallback (Ollama / LM Studio) ---
# Used only if no CLI binary is found at HERMES_PATH / HERMES_CMD.
HERMES_BASE_URL=http://localhost:11434/v1
HERMES_MODEL=hermes3
